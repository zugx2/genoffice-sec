{
  "name": "@genoffice/backend",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "GenOffice cloud backend service: Fastify API validating Keycloak-issued access tokens locally via the realm JWKS",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "tsx scripts/integration.mts"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.23.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
